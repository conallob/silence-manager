apiVersion: v1
kind: Secret
metadata:
  name: silence-manager-secrets
  namespace: monitoring
type: Opaque
stringData:
  # Jira Configuration
  jira-url: "https://your-domain.atlassian.net"
  jira-username: "your-email@example.com"
  jira-api-token: "your-jira-api-token"

  # Linear Configuration (when ticket-system is "linear")
  # Use ONE of the following (setting both is an error):
  # linear-api-key: "lin_api_xxxxxxxx"            # personal API key
  # linear-oauth-token: "your-oauth-access-token" # OAuth app access token (least privilege)

  # Pylon Configuration (when ticket-system is "pylon")
  # pylon-api-token: "your-pylon-api-token"

  # Alertmanager Authentication (optional)
  # For basic auth:
  alertmanager-username: "admin"
  alertmanager-password: "your-password"

  # For bearer token auth:
  # alertmanager-bearer-token: "your-bearer-token"
